{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/page/2.0.0/schema.json",
  "name": "tooltip",
  "displayName": "Country tooltip",
  "displayOption": "ActualSize",
  "height": 200,
  "width": 320,
  "objects": {
    "background": [
      {
        "properties": {
          "image": {
            "image": {
              "name": {
                "expr": {
                  "Literal": {
                    "Value": "'bg_tooltip.png'"
                  }
                }
              },
              "url": {
                "expr": {
                  "ResourcePackageItem": {
                    "PackageName": "RegisteredResources",
                    "PackageType": 1,
                    "ItemName": "bg_tooltip.png"
                  }
                }
              },
              "scaling": {
                "expr": {
                  "Literal": {
                    "Value": "'Fit'"
                  }
                }
              }
            }
          },
          "transparency": {
            "expr": {
              "Literal": {
                "Value": "0D"
              }
            }
          }
        }
      }
    ],
    "outspace": [
      {
        "properties": {
          "color": {
            "solid": {
              "color": {
                "expr": {
                  "Literal": {
                    "Value": "'#050A18'"
                  }
                }
              }
            }
          }
        }
      }
    ]
  },
  "pageBinding": {
    "name": "tooltip_binding",
    "type": "Tooltip",
    "parameters": []
  },
  "type": "Tooltip",
  "visibility": "HiddenInViewMode"
}
