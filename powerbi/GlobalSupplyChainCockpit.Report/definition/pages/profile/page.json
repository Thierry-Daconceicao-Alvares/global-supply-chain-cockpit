{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/page/2.0.0/schema.json",
  "name": "profile",
  "displayName": "Country profile",
  "displayOption": "FitToPage",
  "height": 720,
  "width": 1280,
  "objects": {
    "background": [
      {
        "properties": {
          "image": {
            "image": {
              "name": {
                "expr": {
                  "Literal": {
                    "Value": "'bg_profile.png'"
                  }
                }
              },
              "url": {
                "expr": {
                  "ResourcePackageItem": {
                    "PackageName": "RegisteredResources",
                    "PackageType": 1,
                    "ItemName": "bg_profile.png"
                  }
                }
              },
              "scaling": {
                "expr": {
                  "Literal": {
                    "Value": "'Fit'"
                  }
                }
              }
            }
          },
          "transparency": {
            "expr": {
              "Literal": {
                "Value": "0D"
              }
            }
          }
        }
      }
    ],
    "outspace": [
      {
        "properties": {
          "color": {
            "solid": {
              "color": {
                "expr": {
                  "Literal": {
                    "Value": "'#F2F5FA'"
                  }
                }
              }
            }
          }
        }
      }
    ]
  },
  "pageBinding": {
    "name": "profile_binding",
    "type": "Drillthrough",
    "parameters": [
      {
        "name": "profile_country",
        "boundFilter": "dt_country",
        "fieldExpr": {
          "Column": {
            "Expression": {
              "SourceRef": {
                "Entity": "Geography"
              }
            },
            "Property": "country"
          }
        }
      }
    ]
  },
  "filterConfig": {
    "filters": [
      {
        "name": "dt_country",
        "field": {
          "Column": {
            "Expression": {
              "SourceRef": {
                "Entity": "Geography"
              }
            },
            "Property": "country"
          }
        },
        "type": "Categorical",
        "howCreated": "Drillthrough"
      }
    ]
  },
  "type": "Drillthrough",
  "visibility": "HiddenInViewMode"
}
