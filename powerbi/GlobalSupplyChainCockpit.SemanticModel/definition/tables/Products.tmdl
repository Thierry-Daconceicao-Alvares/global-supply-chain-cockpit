		lineageTag: 55f2dab6-8dd7-5579-87a6-4471f973046e
		summarizeBy: none
		sourceColumn: category

		annotation SummarizationSetBy = Automatic

	/// Department.
	column department
		dataType: string
		lineageTag: 7ba5a0c7-2cfd-56d1-b340-754348c162f7
		summarizeBy: none
		sourceColumn: department

		annotation SummarizationSetBy = Automatic

	/// List price.
	column list_price
		dataType: double
