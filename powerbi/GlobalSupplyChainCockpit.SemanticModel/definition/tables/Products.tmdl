		annotation SummarizationSetBy = Automatic

	partition Products = m
		mode: import
		source =
				let
				    Root = Text.TrimEnd(DataFolder, "\") & "\",
				    Source = Parquet.Document(File.Contents(Root & "products.parquet"))
				in
				    Source

	annotation PBI_ResultType = Table
