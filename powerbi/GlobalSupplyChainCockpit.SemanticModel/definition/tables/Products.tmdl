/// Products, categories and departments.
table Products
	lineageTag: 8999fc3a-5c94-5291-abe1-58ff1d377a94

	column product_id
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: ddd5f8cc-1731-54e1-8681-e8ebd16520ca
		summarizeBy: none
		sourceColumn: product_id

		annotation SummarizationSetBy = Automatic

	/// Product.
	column product
		dataType: string
		lineageTag: 17a969a1-206d-55af-9b8b-bcd5b6f125e9
		summarizeBy: none
		sourceColumn: product

		annotation SummarizationSetBy = Automatic

	/// Product category.
	column category
