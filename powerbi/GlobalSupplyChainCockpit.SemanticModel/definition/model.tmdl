model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["DataFolder", "Sales", "Geography", "Markets", "Products", "ShippingModes", "Dates"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

ref table Sales
ref table Geography
ref table Markets
ref table Products
ref table ShippingModes
ref table Dates
ref table 'Delay Tolerance'
ref table _Measures
